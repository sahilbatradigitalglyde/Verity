# ---- core ----
ENV=development
DATABASE_URL=sqlite:///./verity.db
# postgres example: postgresql+psycopg://verity:verity@localhost:5432/verity
CORS_ORIGINS=http://localhost:5173

# Development only: accept the X-Demo-User header (dev|tester|admin|developer|tester_lead) instead of an Entra token.
AUTH_DEV_BYPASS=true

# ---- Microsoft Entra ID ----
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=          # app registration for the Verity API (audience)
ENTRA_API_CLIENT_SECRET=      # used for the on-behalf-of flow to Azure DevOps
ENTRA_GROUP_ROLE_MAP=         # JSON: {"<group-object-id>": "senior_developer", ...}

# ---- source control ----
SCM_MODE=demo                 # demo | azure_devops
ADO_ORGANIZATIONS=contoso-health,contoso-labs

# ---- AI providers (both run inside Verity) ----
AI_MODE=live                  # live | demo  (demo returns the prototype's sample replies, no network)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=verity-gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21

CLAUDE_HOSTING=anthropic      # anthropic | foundry
ANTHROPIC_API_KEY=
CLAUDE_FOUNDRY_RESOURCE=      # when CLAUDE_HOSTING=foundry
CLAUDE_FOUNDRY_API_KEY=
CLAUDE_MODEL=                 # the Claude model id your org approved
AI_MAX_TOKENS=8000

# ---- evidence storage ----
EVIDENCE_STORAGE_CONNECTION_STRING=
EVIDENCE_CONTAINER=evidence
